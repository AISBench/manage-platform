# Copy to .env; never commit secrets. Preview: npm run demo (isolated data).
DEMO_MODE=false
PORT=3210
HOST=127.0.0.1
BASE_URL=http://127.0.0.1:3210
DATA_DIR=./data
GITHUB_REPO=AISBench/benchmark
# GitHub OAuth App callback: BASE_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Runtime access/roles come ONLY from database members, not environment lists.
# New install: npm run bootstrap -- --github YOUR_GITHUB_LOGIN
# v0.1 upgrade ONLY: set old lists then npm run migrate:members.
# ADMIN_GITHUB_LOGINS=Libotry
# ALLOWED_GITHUB_LOGINS=member-a,member-b
# Repository reader token, READ ONLY for target Issues/PRs/Checks/statuses.
# It is separate from OAuth login and from the source repository deploy key.
GITHUB_TOKEN=
# Strong random webhook secret. Payload URL: BASE_URL/api/webhooks/github
GITHUB_WEBHOOK_SECRET=
# Feishu enterprise internal app with published bot and allowed members.
# OAuth redirect URI: BASE_URL/auth/feishu/callback
FEISHU_APP_ID=
FEISHU_APP_SECRET=
SYNC_INTERVAL_MINUTES=10
# Optional exact trusted reverse-proxy address/subnet list. Never use true/1.
# Docker behind host Caddy may require your actual Docker bridge gateway /32.
# TRUST_PROXY=172.18.0.1/32
EVENT_RETENTION_DAYS=30
RECORD_RETENTION_DAYS=180
# v0.3: registration/public access policies live in database and admin UI.
# Production public data defaults OFF: verify public repo, enable, then full sync.
# Unknown GitHub users can apply but never become members without admin approval.
