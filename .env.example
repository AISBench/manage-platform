# Copy to .env; never commit secrets. Preview: npm run demo (isolated data).
DEMO_MODE=false
PORT=3210
HOST=127.0.0.1
BASE_URL=http://127.0.0.1:3210
DATA_DIR=./data
GITHUB_REPO=AISBench/benchmark
# GitHub OAuth App callback: BASE_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OAuth scopes for login. Use public_repo for public repositories and repo for private ones.
GITHUB_OAUTH_SCOPE=read:user public_repo
# AES-256-GCM key for per-member GitHub write tokens. Generate: openssl rand -base64 32
# Leave empty to auto-generate DATA_DIR/token-encryption.key on first start.
# Set it explicitly when multiple instances share one database, and back up the key file.
TOKEN_ENCRYPTION_KEY=
# Fallback polling interval for Issue/PR conversations (webhook is the real-time path).
CONVERSATION_POLL_MINUTES=5
# Runtime access/roles come ONLY from database members, not environment lists.
# New install: npm run bootstrap -- --github YOUR_GITHUB_LOGIN
# v0.1 upgrade ONLY: set old lists then npm run migrate:members.
# ADMIN_GITHUB_LOGINS=Libotry
# ALLOWED_GITHUB_LOGINS=member-a,member-b
# Repository reader token, READ ONLY for target Issues/PRs/Checks/statuses.
# It is separate from OAuth login and from the source repository deploy key.
GITHUB_TOKEN=
# Optional server-side fallback for GitHub Actions "全量重试" when the
# organization blocks OAuth Apps. Fine-grained PAT: Actions (write) + Metadata (read).
GITHUB_ACTIONS_TOKEN=
# Strong random webhook secret. Payload URL: BASE_URL/api/webhooks/github
GITHUB_WEBHOOK_SECRET=
# Feishu notification channels (both optional).
# Default/recommended: each member configures a personal custom-bot webhook in
# the UI. It works across Feishu tenants and for Lark (open.larksuite.com) and
# is encrypted with TOKEN_ENCRYPTION_KEY below.
# Optional enterprise channel: a self-built Feishu app for members inside the
# deployer's tenant. OAuth redirect URI: BASE_URL/auth/feishu/callback
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional: platform-agent-adaptor integration for knowledge-base search,
# Agent draft publishing and the legacy internal LLM trigger. Leave URL or token
# empty to disable it. Must match the adaptor ADAPTOR_API_* settings.
# Legacy ISSUE_MASTER_URL / ISSUE_MASTER_TOKEN are still accepted.
AGENT_ADAPTOR_URL=
AGENT_ADAPTOR_TOKEN=
AGENT_ADAPTOR_TIMEOUT_MS=15000
# Agent access: personal tokens + issue context + read-only KB search proxy.
# Set to false to hide the Agent page and return 404 for /api/agent/*.
AGENT_ACCESS_ENABLED=true
# How the Agent page tells clients to start the MCP server. Defaults to the
# published npm package. For a local/source checkout use node + cli.js, e.g.
# AGENT_MCP_COMMAND=node
# AGENT_MCP_ARGS=["D:/path/to/agent-mcp/bin/cli.js","serve"]
AGENT_MCP_COMMAND=npx
AGENT_MCP_ARGS=["-y","aisbench-mcp"]
SYNC_INTERVAL_MINUTES=10
# Optional exact trusted reverse-proxy address/subnet list. Never use true/1.
# Docker behind host Caddy may require your actual Docker bridge gateway /32.
# TRUST_PROXY=172.18.0.1/32
EVENT_RETENTION_DAYS=30
RECORD_RETENTION_DAYS=180
# v0.3: registration/public access policies live in database and admin UI.
# Production public data defaults OFF: verify public repo, enable, then full sync.
# Unknown GitHub users can apply but never become members without admin approval.
