    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cli.js serve",
    "smoke": "node tests/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  }
