{
  "name": "aisbench-mcp",
  "version": "0.1.0",
  "description": "MCP server for AISBench Triage: issue/PR context, read-only knowledge base search and agent task submission.",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aisbench",
    "triage",
    "agent"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "aisbench-mcp": "bin/cli.js"
  },
  "files": [
