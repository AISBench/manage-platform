{
  "name": "aisbench-triage",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "demo": "node --env-file=.env.demo server/index.js",
    "bootstrap": "node --env-file-if-exists=.env server/cli.js bootstrap",
    "migrate:members": "node --env-file-if-exists=.env server/cli.js migrate-members",
    "recover:admin": "node --env-file-if-exists=.env server/cli.js recover-admin",
    "backup": "node --env-file-if-exists=.env server/cli.js backup",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": { "vite": "^7.2.0", "@playwright/test": "^1.56.0" }
}
